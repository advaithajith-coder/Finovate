---
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <a href="/" class="logo">
        <span class="logo-icon"></span>
        Finovate.AI
      </a>
      <p class="tagline">Intelligent Finance.</p>
    </div>
    <div class="footer-links">
      <div class="link-group">
        <h4>Solutions</h4>
        <a href="/ar-management">AR Management</a>
        <a href="/invoice-processing">Invoice Processing</a>
        <a href="/rag-assistant">RAG AI Assistant</a>
      </div>
      <div class="link-group">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} Finovate.AI. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-dark);
    border-top: 1px solid var(--border-glass);
    padding: 4rem 0 2rem;
    margin-top: 6rem;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    background: linear-gradient(135deg, var(--brand-teal-light), var(--brand-teal-dark));
    border-radius: 50%;
    display: inline-block;
  }

  .tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 250px;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
  }

  .link-group h4 {
    color: var(--text-main);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .link-group a {
    display: block;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-glass);
    padding-top: 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
