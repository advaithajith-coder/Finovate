---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { href, variant = 'primary', class: className = '', size = 'md' } = Astro.props;

const Element = href ? 'a' : 'button';
---

<Element href={href} class={`btn btn-${variant} btn-${size} ${className}`}>
  <span class="btn-bg"></span>
  <span class="btn-glow"></span>
  <span class="btn-text"><slot /></span>
</Element>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    text-decoration: none;
    border: 1px solid transparent;
    letter-spacing: 0.3px;
    overflow: hidden;
    gap: 0.5rem;
  }

  .btn-sm { padding: 0.5rem 1.2rem; font-size: 0.8rem; }
  .btn-md { padding: 0.7rem 1.6rem; font-size: 0.85rem; }
  .btn-lg { padding: 1rem 2.5rem; font-size: 1rem; }

  .btn-text {
    position: relative;
    z-index: 2;
  }

  .btn-bg {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 1;
    transition: opacity 0.4s ease;
  }

  .btn-glow {
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    filter: blur(8px);
  }

  .btn-primary {
    background: transparent;
    color: var(--text-main);
    border-color: rgba(255, 77, 0, 0.35);
    box-shadow: inset 0 0 10px rgba(255, 77, 0, 0.08), 0 0 15px rgba(255, 77, 0, 0.06);
  }

  .btn-primary .btn-bg {
    background: linear-gradient(135deg, rgba(255, 77, 0, 0.12), rgba(255, 77, 0, 0.03));
  }

  .btn-primary .btn-glow {
    background: linear-gradient(135deg, rgba(255, 77, 0, 0.3), transparent);
  }

  .btn-primary:hover {
    border-color: rgba(255, 77, 0, 0.7);
    box-shadow: inset 0 0 15px rgba(255, 77, 0, 0.15), 0 0 35px rgba(255, 77, 0, 0.2);
    transform: translateY(-2px);
  }

  .btn-primary:hover .btn-glow {
    opacity: 1;
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-outline {
    background: transparent;
    border-color: var(--border-glass);
    color: var(--text-muted);
  }

  .btn-outline .btn-glow {
    background: linear-gradient(135deg, rgba(0, 102, 255, 0.3), transparent);
  }

  .btn-outline:hover {
    border-color: rgba(0, 102, 255, 0.5);
    color: var(--text-main);
    box-shadow: 0 0 20px rgba(0, 102, 255, 0.1);
    transform: translateY(-2px);
  }

  .btn-outline:hover .btn-glow {
    opacity: 0.5;
  }

  .btn-ghost {
    background: transparent;
    border-color: transparent;
    color: var(--text-muted);
  }

  .btn-ghost:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.03);
  }
</style>
