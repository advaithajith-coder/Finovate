---
interface Props {
  class?: string;
  variant?: 'default' | 'glow' | 'bento';
}

const { class: className = '', variant = 'default' } = Astro.props;
---

<div class={`glass-panel p-card card-${variant} ${className}`}>
  <slot />
</div>

<style>
  .p-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: linear-gradient(145deg, rgba(10, 10, 10, 0.7), rgba(15, 15, 15, 0.5));
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: var(--radius-md);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
  }

  .p-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.03), transparent 60%);
    pointer-events: none;
  }

  .p-card::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.02), transparent 50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .p-card:hover {
    border-color: rgba(255,255,255,0.12);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), var(--glow-blue);
  }

  .p-card:hover::after {
    opacity: 1;
  }

  .card-glow {
    border-color: rgba(0, 102, 255, 0.15);
  }

  .card-glow:hover {
    border-color: rgba(0, 102, 255, 0.3);
    box-shadow: 0 12px 50px rgba(0, 102, 255, 0.15), var(--glow-blue);
  }

  .card-bento {
    border-radius: var(--radius-xl);
    border-color: rgba(255,255,255,0.06);
    background: linear-gradient(145deg, rgba(15, 15, 15, 0.8), rgba(8, 8, 8, 0.6));
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .card-bento:hover {
    border-color: rgba(255,255,255,0.12);
    transform: translateY(-4px);
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.5);
  }
</style>
