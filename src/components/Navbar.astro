---
import Button from './Button.astro';
---

<div class="navbar-wrapper" id="navbar">
  <header class="navbar">
    <a href="/" class="logo">
      <svg class="logo-icon" viewBox="0 0 28 28" fill="none">
        <rect x="2" y="2" width="24" height="24" rx="8" stroke="url(#logo-grad)" stroke-width="1.5"/>
        <path d="M8 14L12 10L16 14L20 10" stroke="url(#logo-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="14" cy="16" r="2" fill="url(#logo-grad)"/>
        <defs>
          <linearGradient id="logo-grad" x1="4" y1="4" x2="24" y2="24">
            <stop stop-color="#3385ff"/>
            <stop offset="1" stop-color="#ff6a2b"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="logo-text">Finovate<span class="logo-dot">.</span>AI</span>
    </a>
    <nav class="nav-links">
      <div class="nav-item has-mega">
        <a href="/ar-management">AR Management</a>
        <div class="mega-menu">
          <div class="mega-inner">
            <div class="mega-featured">
              <div class="mega-feat-card">
                <div class="mega-feat-header">
                  <span>Agent Development Cycle</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12L12 4M12 4H6M12 4V10"/>
                  </svg>
                </div>
                <div class="mega-flow">
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Audit</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step active">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Train</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Deploy</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Monitor</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="mega-links">
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="9" r="7"/>
                    <path d="M9 5v4l3 2"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Agent Studio</span>
                  <span class="mega-link-desc">Build custom AI agents for finance</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 9h14M9 2v14"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Task Mining</span>
                  <span class="mega-link-desc">Identify automation opportunities</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M1 9l4-4 4 4 4-4 4 4"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Agentic Automation</span>
                  <span class="mega-link-desc">End-to-end workflow automation</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="5" r="3"/>
                    <path d="M3 16c0-4 2.7-6 6-6s6 2 6 6"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Self-Learning AI</span>
                  <span class="mega-link-desc">Models that improve over time</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item has-mega">
        <a href="/invoice-processing">Invoice Processing</a>
        <div class="mega-menu">
          <div class="mega-inner">
            <div class="mega-featured">
              <div class="mega-feat-card">
                <div class="mega-feat-header">
                  <span>Invoice Processing Pipeline</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12L12 4M12 4H6M12 4V10"/>
                  </svg>
                </div>
                <div class="mega-flow">
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Extract</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step active">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Validate</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Code</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Sync</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="mega-links">
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="4" width="14" height="10" rx="1.5"/>
                    <path d="M6 8h6M6 11h4"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Smart OCR</span>
                  <span class="mega-link-desc">Template-free data extraction</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 9h12"/>
                    <path d="M9 3v12"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">GL Coding</span>
                  <span class="mega-link-desc">Automated account assignment</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 3l4 4M3 15l4-4M15 3l-4 4M15 15l-4-4"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">3-Way Matching</span>
                  <span class="mega-link-desc">PO, receipt & invoice validation</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 14l4-4 3 3 3-5"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">ERP Sync</span>
                  <span class="mega-link-desc">Real-time integration</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item has-mega">
        <a href="/rag-assistant">RAG Assistant</a>
        <div class="mega-menu">
          <div class="mega-inner">
            <div class="mega-featured">
              <div class="mega-feat-card">
                <div class="mega-feat-header">
                  <span>RAG Architecture</span>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12L12 4M12 4H6M12 4V10"/>
                  </svg>
                </div>
                <div class="mega-flow">
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Query</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step active">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Retrieve</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Generate</div>
                  </div>
                  <div class="flow-line"></div>
                  <div class="flow-step">
                    <div class="flow-dot"></div>
                    <div class="flow-label">Respond</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="mega-links">
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="9" r="7"/>
                    <path d="M9 5v4l3 2"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Smart Search</span>
                  <span class="mega-link-desc">Semantic search over your docs</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 3v12M3 9h12"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Policy Lookup</span>
                  <span class="mega-link-desc">Instant compliance answers</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 3l4 4M3 15l4-4M15 3l-4 4M15 15l-4-4"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Document QA</span>
                  <span class="mega-link-desc">Ask questions about any file</span>
                </div>
              </div>
              <div class="mega-link-item">
                <div class="mega-link-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="3" width="14" height="12" rx="1.5"/>
                    <path d="M6 7h6M6 10h4"/>
                  </svg>
                </div>
                <div class="mega-link-text">
                  <span class="mega-link-title">Audit Trail</span>
                  <span class="mega-link-desc">Every answer fully cited</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href="/architecture">Architecture</a>
      </div>
      <div class="nav-item">
        <a href="/about">About</a>
      </div>
    </nav>
    <div class="nav-actions">
      <Button href="/contact" variant="primary" size="sm">Get a Free Demo</Button>
    </div>
    <button class="mobile-toggle" aria-label="Menu" id="mobile-toggle">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>
  </header>
</div>

<div class="mobile-overlay" id="mobile-overlay">
  <nav class="mobile-nav">
    <a href="/ar-management">AR Management</a>
    <a href="/invoice-processing">Invoice Processing</a>
    <a href="/rag-assistant">RAG Assistant</a>
    <a href="/architecture">Architecture</a>
    <a href="/about">About</a>
    <a href="/contact" class="mobile-cta">Get a Free Demo</a>
  </nav>
</div>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const overlay = document.getElementById('mobile-overlay');
  if (toggle && overlay) {
    toggle.addEventListener('click', () => {
      overlay.classList.toggle('open');
      toggle.classList.toggle('active');
    });
  }
</script>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 1.5rem;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .navbar {
    pointer-events: auto;
    background: rgba(8, 8, 8, 0.75);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 10px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    border-radius: 9999px;
    padding: 0.4rem 0.8rem 0.4rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 90%;
    max-width: 1100px;
    height: 58px;
    transition: all 0.3s ease;
  }

  .navbar:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-main);
    text-decoration: none;
  }

  .logo-icon { width: 26px; height: 26px; }
  .logo-text { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.5px; }
  .logo-dot { color: var(--brand-orange-light); }

  .nav-links {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-item > a {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
    position: relative;
    text-decoration: none;
    padding: 0.3rem 0;
  }

  .nav-item > a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--brand-blue-light);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nav-item > a:hover { color: var(--text-main); }
  .nav-item > a:hover::after { width: 80%; }

  /* MEGA MENU */
  .has-mega {
    position: static;
  }

  .mega-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    z-index: 200;
  }

  .nav-item:hover .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .mega-inner {
    width: 680px;
    background: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.6);
  }

  .mega-feat-card {
    background: linear-gradient(145deg, rgba(15, 15, 15, 0.9), rgba(5, 5, 5, 0.7));
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 1.2rem;
  }

  .mega-feat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 1rem;
  }

  .mega-feat-header svg {
    color: var(--brand-blue-light);
  }

  .mega-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .flow-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .flow-step.active .flow-dot {
    background: var(--brand-blue-light);
    box-shadow: 0 0 12px rgba(51, 133, 255, 0.4);
  }

  .flow-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .flow-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    margin: 0 0.3rem;
  }

  .mega-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mega-link-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mega-link-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .mega-link-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue-light);
    flex-shrink: 0;
  }

  .mega-link-text {
    display: flex;
    flex-direction: column;
  }

  .mega-link-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-main);
  }

  .mega-link-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 110;
  }

  .toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-muted);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-toggle.active .toggle-bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mobile-toggle.active .toggle-bar:nth-child(2) { opacity: 0; }
  .mobile-toggle.active .toggle-bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0,0,0,0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .mobile-overlay.open { opacity: 1; pointer-events: auto; }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 2rem;
  }

  .mobile-nav a {
    color: var(--text-main);
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .mobile-nav a:hover { opacity: 1; }

  .mobile-cta {
    padding: 0.8rem 2rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 77, 0, 0.4);
    color: var(--text-main) !important;
    opacity: 1 !important;
  }

  @media (max-width: 900px) {
    .nav-links, .nav-actions { display: none; }
    .mobile-toggle { display: flex; }
    .mobile-overlay { display: block; }
  }
</style>
