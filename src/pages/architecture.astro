---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GlowBackground from '../components/GlowBackground.astro';
import Card from '../components/Card.astro';
---

<Layout title="Architecture - Finovate.AI">
  <GlowBackground />
  <Navbar />
  
  <main class="page-container">
    <!-- PROFILE HEADER -->
    <section class="container text-center pt-nav">
      <span class="pill-label pill-orange">ARCHITECTURE</span>
      <h1 class="page-title">Product Architecture</h1>
      <p class="page-subtitle">Every product at Finovate.AI is engineered on a modular AI-native stack, purpose-built for finance workflows that demand precision, security, and scale.</p>
    </section>

    <!-- ARCHITECTURE OVERVIEW -->
    <section class="container mt-8">
      <div class="section-header">
        <h2 class="section-title">System Architecture</h2>
        <p class="section-desc">End-to-end architecture powering autonomous finance workflows.</p>
      </div>

      <div class="arch-flow">
        <div class="arch-layer">
          <div class="layer-label">DATA INGESTION</div>
          <div class="layer-items">
            <span class="layer-tag">Multi-format Parsing</span>
            <span class="layer-tag">ERP Connectors</span>
            <span class="layer-tag">Email / WhatsApp Integration</span>
            <span class="layer-tag">Bank Feed APIs</span>
          </div>
        </div>
        <div class="arch-arrow">&darr;</div>
        <div class="arch-layer">
          <div class="layer-label">AI PROCESSING</div>
          <div class="layer-items">
            <span class="layer-tag">Vision Transformers</span>
            <span class="layer-tag">LayoutLM</span>
            <span class="layer-tag">RAG Pipelines</span>
            <span class="layer-tag">Agentic Workflows</span>
          </div>
        </div>
        <div class="arch-arrow">&darr;</div>
        <div class="arch-layer">
          <div class="layer-label">KNOWLEDGE & MEMORY</div>
          <div class="layer-items">
            <span class="layer-tag">Vector Databases</span>
            <span class="layer-tag">Semantic Search</span>
            <span class="layer-tag">Embedding Models</span>
            <span class="layer-tag">Graph Memory</span>
          </div>
        </div>
        <div class="arch-arrow">&darr;</div>
        <div class="arch-layer">
          <div class="layer-label">OUTPUT & INTEGRATION</div>
          <div class="layer-items">
            <span class="layer-tag">API Gateway</span>
            <span class="layer-tag">Real-time Sync</span>
            <span class="layer-tag">Structured Data Export</span>
            <span class="layer-tag">Audit Logs</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE AI CONCEPTS -->
    <section class="container mt-8">
      <div class="section-header">
        <h2 class="section-title">AI Concepts That Power the Stack</h2>
      </div>
      <div class="concepts-grid">
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>RAG</h3>
          <p>Retrieval-Augmented Generation enables LLMs to query private financial documents and return cited, accurate answers without ever hallucinating on your data.</p>
        </Card>
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>Agentic Workflows</h3>
          <p>Multi-agent systems that plan, execute, and verify complex finance tasks like autonomous reconciliation, dynamic collections, and audit trail generation.</p>
        </Card>
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>Vision Transformers</h3>
          <p>State-of-the-art computer vision models that understand document layout, enabling template-free extraction from any invoice, receipt, or bank statement.</p>
        </Card>
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>Vector Databases</h3>
          <p>High-dimensional embeddings power ultrafast semantic search across millions of transactions, policies, and documents, finding meaning and not just keywords.</p>
        </Card>
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>Fine-Tuned LLMs</h3>
          <p>Domain-specific models fine-tuned on accounting terminology, GST rules, Ind-AS standards, and Indian financial workflows for unmatched accuracy.</p>
        </Card>
        <Card class="concept-card">
          <div class="concept-icon">&#9881;</div>
          <h3>Structured Extraction</h3>
          <p>LLM-powered extraction pipelines that convert unstructured financial data into structured formats, ready for ERP ingestion and real-time reporting.</p>
        </Card>
      </div>
    </section>

    <!-- TECH STACK -->
    <section class="container mt-8">
      <div class="section-header">
        <h2 class="section-title">Tech Stack</h2>
        <p class="section-desc">Production-grade technologies powering every layer of the Finovate.AI platform.</p>
      </div>

      <div class="stack-section">
        <h3 class="stack-category">AI & ML</h3>
        <div class="stack-grid">
          <span class="stack-badge">Python</span>
          <span class="stack-badge">LangChain</span>
          <span class="stack-badge">LlamaIndex</span>
          <span class="stack-badge">OpenAI GPT-4o</span>
          <span class="stack-badge">Anthropic Claude 3.5</span>
          <span class="stack-badge">Hugging Face</span>
          <span class="stack-badge">PyTorch</span>
          <span class="stack-badge">TensorFlow</span>
          <span class="stack-badge">LangGraph</span>
        </div>
      </div>

      <div class="stack-section">
        <h3 class="stack-category">Data & Vector Stores</h3>
        <div class="stack-grid">
          <span class="stack-badge">Pinecone</span>
          <span class="stack-badge">Weaviate</span>
          <span class="stack-badge">ChromaDB</span>
          <span class="stack-badge">PostgreSQL</span>
          <span class="stack-badge">Redis</span>
          <span class="stack-badge">Apache Kafka</span>
        </div>
      </div>

      <div class="stack-section">
        <h3 class="stack-category">Backend & Infrastructure</h3>
        <div class="stack-grid">
          <span class="stack-badge">FastAPI</span>
          <span class="stack-badge">Node.js</span>
          <span class="stack-badge">Docker</span>
          <span class="stack-badge">Kubernetes</span>
          <span class="stack-badge">AWS</span>
          <span class="stack-badge">GCP</span>
          <span class="stack-badge">Azure</span>
          <span class="stack-badge">Terraform</span>
        </div>
      </div>

      <div class="stack-section">
        <h3 class="stack-category">Frontend & APIs</h3>
        <div class="stack-grid">
          <span class="stack-badge">React</span>
          <span class="stack-badge">Astro</span>
          <span class="stack-badge">TypeScript</span>
          <span class="stack-badge">GraphQL</span>
          <span class="stack-badge">REST</span>
          <span class="stack-badge">WebSocket</span>
        </div>
      </div>
    </section>

    <!-- HOW AI IS USED ACROSS PRODUCTS -->
    <section class="container mt-8">
      <div class="section-header">
        <h2 class="section-title">AI in Every Product</h2>
      </div>
      <div class="product-ai-grid">
        <Card class="product-card">
          <h3>AR Management AI</h3>
          <p>Agentic workflows analyze payment history, client behaviour, and invoice aging to autonomously send contextual follow-ups and predict DSO.</p>
          <div class="product-techs">
            <span class="mini-badge">LangGraph</span>
            <span class="mini-badge">GPT-4o</span>
            <span class="mini-badge">PostgreSQL</span>
          </div>
        </Card>
        <Card class="product-card">
          <h3>Smart Invoice Processing</h3>
          <p>Vision Transformers + LayoutLM extract every field from any invoice layout with no templates or rules, just pixel-perfect structured data.</p>
          <div class="product-techs">
            <span class="mini-badge">PyTorch</span>
            <span class="mini-badge">LayoutLM</span>
            <span class="mini-badge">FastAPI</span>
          </div>
        </Card>
        <Card class="product-card">
          <h3>RAG AI Assistant</h3>
          <p>Retrieval-Augmented Generation over your private document repository delivers instant, cited answers to any finance or policy question.</p>
          <div class="product-techs">
            <span class="mini-badge">LlamaIndex</span>
            <span class="mini-badge">Pinecone</span>
            <span class="mini-badge">Claude 3.5</span>
          </div>
        </Card>
      </div>
    </section>

    <!-- WHY THIS MATTERS -->
    <section class="container mt-8 mb-8">
      <Card class="why-card">
        <h2>Built Different. Built for Finance.</h2>
        <p>We don't wrap API calls and call it a product. Every pipeline is engineered end-to-end, from ingestion to inference to audit, so your finance team gets accuracy, transparency, and speed they can trust.</p>
        <div class="why-stats">
          <div class="why-stat">
            <span class="why-num">99%+</span>
            <span class="why-label">Extraction Accuracy</span>
          </div>
          <div class="why-stat">
            <span class="why-num">80%</span>
            <span class="why-label">Manual Work Reduced</span>
          </div>
          <div class="why-stat">
            <span class="why-num">10&times;</span>
            <span class="why-label">Faster Reconciliation</span>
          </div>
        </div>
      </Card>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .pt-nav { padding-top: 150px; }
  .mt-8 { margin-top: 6rem; margin-bottom: 6rem; }
  .mb-8 { margin-bottom: 8rem; }
  .mt-4 { margin-top: 2rem; }
  .text-center { text-align: center; }

  .pill-orange {
    border: 1px solid rgba(255, 77, 0, 0.3);
    color: var(--text-main);
    background: rgba(255, 77, 0, 0.05);
  }

  .page-title {
    font-size: 3.5rem;
    margin-bottom: 1.2rem;
    background: linear-gradient(135deg, #fff 60%, var(--brand-blue-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2.3rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Architecture Flow */
  .arch-flow {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .arch-layer {
    width: 100%;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 1.5rem 2rem;
    transition: all 0.3s ease;
  }

  .arch-layer:hover {
    background: rgba(255,255,255,0.06);
    border-color: rgba(0, 102, 255, 0.3);
    transform: translateY(-2px);
  }

  .layer-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--brand-orange-light);
    margin-bottom: 0.8rem;
    font-weight: 600;
  }

  .layer-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .layer-tag {
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    background: rgba(0, 102, 255, 0.08);
    border: 1px solid rgba(0, 102, 255, 0.15);
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .arch-arrow {
    color: var(--brand-blue);
    font-size: 1.5rem;
    opacity: 0.5;
  }

  /* AI Concepts */
  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .concept-card {
    padding: 1.5rem;
  }

  .concept-card h3 {
    color: var(--brand-blue-light);
    margin-bottom: 0.8rem;
    font-size: 1.2rem;
  }

  .concept-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .concept-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(0, 102, 255, 0.1);
    border: 1px solid rgba(0, 102, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-blue-light);
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  /* Tech Stack */
  .stack-section {
    margin-bottom: 2.5rem;
  }

  .stack-category {
    font-size: 1rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .stack-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .stack-badge {
    padding: 0.5rem 1.2rem;
    border-radius: 9999px;
    background: rgba(0, 102, 255, 0.08);
    border: 1px solid rgba(0, 102, 255, 0.2);
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .stack-badge:hover {
    background: rgba(0, 102, 255, 0.15);
    border-color: rgba(0, 102, 255, 0.4);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 102, 255, 0.15);
  }

  /* Product AI */
  .product-ai-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .product-card {
    padding: 1.5rem;
  }

  .product-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
    color: var(--brand-orange-light);
  }

  .product-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }

  .product-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mini-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Why Card */
  .why-card {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.1), rgba(5, 5, 5, 0.6));
    border-color: var(--brand-blue);
  }

  .why-card h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .why-card > p {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 700px;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }

  .why-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
  }

  .why-stat {
    text-align: center;
  }

  .why-num {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--brand-orange-light);
    margin-bottom: 0.3rem;
  }

  .why-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .concepts-grid,
    .product-ai-grid {
      grid-template-columns: 1fr;
    }
    .why-stats {
      flex-direction: column;
      gap: 2rem;
    }
    .page-title {
      font-size: 2.5rem;
    }
  }
</style>
