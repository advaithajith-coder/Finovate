---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import GlowBackground from '../components/GlowBackground.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<Layout title="RAG AI Assistant - Finovate.AI">
  <GlowBackground />
  <Navbar />
  
  <main class="page-container">
    <section class="container text-center pt-nav">
      <span class="pill-label">ENTERPRISE SEARCH</span>
      <h1 class="page-title">Chat with your <span class="text-gradient">Finance Data.</span></h1>
      <p class="page-subtitle">Instant answers based on your internal policies, historical financials, and compliance docs.</p>
    </section>

    <section class="container mt-8">
      <div class="features-grid">
        <Card>
          <h3>Custom Knowledge Base</h3>
          <p>We train the AI securely on your company's specific financial documents, employee handbooks, and historical audits.</p>
        </Card>
        <Card>
          <h3>Instant Policy Lookup</h3>
          <p>"What is the travel expense limit for regional managers?" Get cited, accurate answers instantly without digging through PDFs.</p>
        </Card>
        <Card>
          <h3>Secure & Private</h3>
          <p>Your data stays yours. We deploy isolated instances of RAG architectures ensuring your financial data never leaks to public models.</p>
        </Card>
      </div>
    </section>

    <section class="container text-center mb-8">
      <Card class="cta-card">
        <h2>Empower your finance team.</h2>
        <p class="mb-4 text-muted">Stop wasting hours searching for precedents and policies.</p>
        <Button href="/contact" variant="primary">Book a Demo</Button>
      </Card>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .pt-nav { padding-top: 150px; }
  .mt-8 { margin-top: 4rem; }
  .mb-8 { margin-bottom: 8rem; }
  .mb-4 { margin-bottom: 1.5rem; }
  .text-center { text-align: center; }
  
  .page-title { font-size: 3.5rem; margin-bottom: 1.5rem; }
  .page-subtitle { font-size: 1.25rem; color: var(--text-muted); max-width: 600px; margin: 0 auto; }
  .text-muted { color: var(--text-muted); }
  
  .text-gradient {
    background: linear-gradient(135deg, #fff, var(--brand-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .features-grid h3 {
    margin-bottom: 1rem;
    color: var(--brand-orange-light);
  }

  .cta-card {
    background: linear-gradient(145deg, rgba(20,20,20,0.8), rgba(5,5,5,0.4));
    border-color: var(--brand-blue);
    padding: 4rem 2rem;
  }

  @media (max-width: 768px) {
    .features-grid { grid-template-columns: 1fr; }
  }
</style>
